{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HASHES Manifest v0.2",
  "type": "object",
  "required": ["pack_id", "created_at", "entries"],
  "properties": {
    "pack_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "id", "path", "blake3"],
        "properties": {
          "kind": { "type": "string", "enum": ["source", "run", "artifact", "schema", "pack"] },
          "id": { "type": "string" },
          "path": { "type": "string" },
          "blake3": { "type": "string" }
        }
      }
    },
    "root_placeholder": { "type": ["string", "null"] }
  }
}
